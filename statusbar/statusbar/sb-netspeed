#!/bin/sh

STATE="/tmp/.sb-netspeed"

iface="$(ip route 2>/dev/null | awk '/default/ {print $5; exit}')"
[ -n "$iface" ] || exit 0

rx_now="$(cat /sys/class/net/$iface/statistics/rx_bytes 2>/dev/null)"
tx_now="$(cat /sys/class/net/$iface/statistics/tx_bytes 2>/dev/null)"
now="$(date +%s)"

[ -n "$rx_now" ] && [ -n "$tx_now" ] || exit 0

if [ -f "$STATE" ]; then
    read -r old_rx old_tx old_time < "$STATE"
    dt=$((now - old_time))
    if [ "$dt" -gt 0 ]; then
        rx_rate=$(( (rx_now - old_rx) / dt ))
        tx_rate=$(( (tx_now - old_tx) / dt ))

        human() {
            if [ "$1" -ge 1048576 ]; then
                awk "BEGIN {printf \"%.1fM\", $1/1048576}"
            else
                awk "BEGIN {printf \"%.0fK\", $1/1024}"
            fi
        }

        printf '↓%s ↑%s' "$(human "$rx_rate")" "$(human "$tx_rate")"
    fi
fi

printf '%s %s %s\n' "$rx_now" "$tx_now" "$now" > "$STATE"
